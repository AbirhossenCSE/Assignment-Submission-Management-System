{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "AssignmentManagementDb"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyHereWithAtLeast32CharactersLength!",
    "Issuer": "AssignmentManagementApi",
    "Audience": "AssignmentManagementClient",
    "ExpiryInMinutes": 60
  },
  "AllowedHosts": "*"
}
